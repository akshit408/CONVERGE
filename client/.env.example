# CONVERGE Platform - Environment Variables

# Backend API URL (Render Web Service URL, e.g. https://converge-backend.onrender.com)
# Leave blank for local development (uses Vite proxy to http://localhost:5000)
VITE_API_URL=

# Google Maps JavaScript API Configuration (Optional - falls back to Leaflet map if omitted)
# Get your API Key from Google Cloud Console: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=
